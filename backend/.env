# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/hostel_expense_management"

# JWT Configuration
JWT_SECRET="hostel-expense-management-super-secret-key-2024"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=3001
NODE_ENV="development"

# Frontend URL Configuration
# Local development:
FRONTEND_URL="http://localhost:8080"

# Production (Vercel deployment):
# FRONTEND_URL="https://hostelexpensemanagement1.vercel.app"
# 
# ⚠️ IMPORTANT: When deploying to Render, add this environment variable:
# FRONTEND_URL=https://hostelexpensemanagement1.vercel.app

# Redis Configuration (for real-time updates)
REDIS_URL="redis://localhost:6379"

# Email Configuration (for password reset)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587

# Data Retention Configuration
DATA_RETENTION_DAYS=90
CLEANUP_INTERVAL_HOURS=24

# Google Authentication
GOOGLE_CLIENT_ID=123456789-placeholder.apps.googleusercontent.com
